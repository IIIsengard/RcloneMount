<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RcloneMount</AssemblyName>
    <RootNamespace>RcloneMount</RootNamespace>
    <Product>RcloneMount</Product>
    <AssemblyTitle>RcloneMount</AssemblyTitle>
    <Version>1.0.22</Version>
    <Company>RcloneMount</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- UI is built in code, never in the WinForms designer, so designer-serialization hints add nothing. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RcloneMount.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- .txt so Windows has an app to open it with -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="provider-icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
